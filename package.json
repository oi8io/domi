{
  "name": "domi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "guard:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "guard:tasks": "bun run scripts/lint-tasks.ts",
    "guard:append-only": "bun run scripts/check-append-only.ts",
    "guard:api": "bun run scripts/gen-api-snapshot.ts --check",
    "guard:purity": "bun run scripts/check-kernel-purity.ts",
    "guard": "pnpm guard:deps && pnpm guard:tasks && pnpm guard:append-only && pnpm guard:api && pnpm guard:purity",
    "check": "pnpm typecheck && pnpm guard && pnpm test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "dependency-cruiser": "^17.0.0",
    "typescript": "^5.9.0",
    "zod": "^3.25.0"
  }
}
