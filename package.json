{
  "name": "domi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test --path-ignore-patterns='eval/l2/tasks/**'",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/tui/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/bridge-telegram/tsconfig.json",
    "guard:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "guard:tasks": "bun run scripts/lint-tasks.ts",
    "guard:append-only": "bun run scripts/check-append-only.ts",
    "guard:api": "bun run scripts/gen-api-snapshot.ts --check",
    "guard:protocol": "bun run scripts/gen-protocol-docs.ts --check",
    "guard:mcp": "bun run scripts/check-deprecated-mcp.ts",
    "guard:automation": "bun run scripts/check-no-selfimpl-automation.ts",
    "guard:purity": "bun run scripts/check-kernel-purity.ts",
    "guard:adr": "bun run scripts/check-adr-fields.ts",
    "guard:bridge": "bun run scripts/check-bridge-payload.ts",
    "guard:docs": "bun run scripts/test-docs-snippets.ts",
    "guard:repo": "bun run scripts/check-repo-meta.ts",
    "guard:l2": "bun run scripts/check-ci-no-l2.ts",
    "guard:desktop": "bun run scripts/check-desktop-size.ts",
    "guard": "pnpm lint && pnpm guard:deps && pnpm guard:tasks && pnpm guard:append-only && pnpm guard:api && pnpm guard:protocol && pnpm guard:mcp && pnpm guard:automation && pnpm guard:purity && pnpm guard:adr && pnpm guard:secrets && pnpm guard:providers && pnpm guard:writes && pnpm guard:ac && pnpm guard:eval && pnpm guard:live && pnpm guard:migrations && pnpm guard:i18n && pnpm guard:bridge && pnpm guard:desktop && pnpm guard:docs && pnpm guard:repo && pnpm guard:l2",
    "check": "pnpm typecheck && pnpm guard && pnpm test && pnpm eval",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "guard:secrets": "bun run scripts/scan-secrets.ts fixtures docs",
    "guard:providers": "bun run scripts/check-provider-isolation.ts",
    "guard:writes": "bun run scripts/check-write-paths.ts",
    "guard:ac": "bun run scripts/check-ac-coverage.ts",
    "guard:eval": "bun run scripts/check-eval-isolation.ts",
    "eval": "bun apps/tui/src/main.tsx eval run",
    "domid": "bun packages/daemon/src/main.ts",
    "web": "pnpm --filter @domi/web dev",
    "build": "bun run scripts/build-binaries.ts",
    "build:all": "bun run scripts/build-binaries.ts --all",
    "smoke": "bun run scripts/build-binaries.ts && bash scripts/smoke-binary.sh",
    "guard:live": "bun run scripts/check-ci-no-live-calls.ts",
    "bench:cache": "bun run scripts/measure-cache.ts",
    "guard:migrations": "bun run scripts/check-migrations.ts",
    "guard:i18n": "bun run scripts/check-i18n.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@domi/store": "workspace:*",
    "@types/bun": "^1.4.0",
    "dependency-cruiser": "^17.0.0",
    "typescript": "^5.9.0",
    "zod": "^4.6.5"
  }
}
