{
  "name": "domi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "guard:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "guard:tasks": "bun run scripts/lint-tasks.ts",
    "guard:append-only": "bun run scripts/check-append-only.ts",
    "guard:api": "bun run scripts/gen-api-snapshot.ts --check",
    "guard:protocol": "bun run scripts/gen-protocol-docs.ts --check",
    "guard:purity": "bun run scripts/check-kernel-purity.ts",
    "guard:adr": "bun run scripts/check-adr-fields.ts",
    "guard": "pnpm lint && pnpm guard:deps && pnpm guard:tasks && pnpm guard:append-only && pnpm guard:api && pnpm guard:protocol && pnpm guard:purity && pnpm guard:adr && pnpm guard:secrets && pnpm guard:providers && pnpm guard:writes && pnpm guard:ac && pnpm guard:eval && pnpm guard:live && pnpm guard:migrations",
    "check": "pnpm typecheck && pnpm guard && pnpm test && pnpm eval",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "guard:secrets": "bun run scripts/scan-secrets.ts fixtures docs",
    "guard:providers": "bun run scripts/check-provider-isolation.ts",
    "guard:writes": "bun run scripts/check-write-paths.ts",
    "guard:ac": "bun run scripts/check-ac-coverage.ts",
    "guard:eval": "bun run scripts/check-eval-isolation.ts",
    "eval": "bun apps/tui/src/main.tsx eval run",
    "build": "bun run scripts/build-binaries.ts",
    "build:all": "bun run scripts/build-binaries.ts --all",
    "smoke": "bun run scripts/build-binaries.ts && bash scripts/smoke-binary.sh",
    "guard:live": "bun run scripts/check-ci-no-live-calls.ts",
    "bench:cache": "bun run scripts/measure-cache.ts",
    "guard:migrations": "bun run scripts/check-migrations.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "dependency-cruiser": "^17.0.0",
    "typescript": "^5.9.0",
    "zod": "^4.6.5",
    "@biomejs/biome": "^2.5.13",
    "@domi/store": "workspace:*"
  }
}
